---
const features = [
  { name: 'parquet', default: true, note: 'ParquetEncoder via arrow, parquet, and serde_arrow' },
  { name: 'csv', default: false, note: 'CsvEncoder for flat record types' },
  { name: 'satay', default: false, note: 'SatayCollector for satay-generated API clients' },
  { name: 'huggingface', default: true, note: 'HfSink and CommitAction; implies parquet and satay' },
];
---

<section class="border-t hairline bg-surface/30">
  <div class="mx-auto max-w-[84rem] px-6 py-20 md:py-28">
    <h2 class="font-display text-4xl leading-tight tracking-[-0.01em] text-ink md:text-5xl">
      Bring only the I/O you need.
    </h2>
    <p class="mt-6 max-w-[44rem] text-lg leading-relaxed text-ink-dim">
      With <code class="font-mono text-sm text-ink">--no-default-features</code>,
      the core keeps its traits and&nbsp;<code class="font-mono text-sm text-ink">JsonEncoder</code>.
      Cargo features add Parquet, CSV, satay collectors, and Hugging Face delivery.
    </p>

    <div class="mt-10">
      <h3 class="mb-4 font-mono text-sm text-ink-dim">Feature flags</h3>
      <div class="overflow-hidden rounded-sm border hairline">
        <table class="w-full border-collapse text-left">
          <thead>
            <tr class="border-b hairline bg-surface">
              <th scope="col" class="py-3 px-5 font-mono text-xs font-normal uppercase tracking-[0.18em] text-ink-faint">feature</th>
              <th scope="col" class="py-3 px-5 font-mono text-xs font-normal uppercase tracking-[0.18em] text-ink-faint">default</th>
              <th scope="col" class="py-3 px-5 font-mono text-xs font-normal uppercase tracking-[0.18em] text-ink-faint">what it enables</th>
            </tr>
          </thead>
          <tbody>
            {features.map((f) => (
              <tr class="border-b border-hairline/60">
                <td class="py-4 px-5 font-mono text-sm text-ink">{f.name}</td>
                <td class="py-4 px-5">
                  <span class={`font-mono text-sm ${f.default ? 'text-accent' : 'text-ink-faint'}`}>
                    {f.default ? '✓' : '·'}
                  </span>
                </td>
                <td class="py-4 px-5 text-sm text-ink-dim">{f.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-10 font-mono text-xs text-ink-faint">
      Missing an integration?&nbsp;
      <a href="https://github.com/InfiniteUnion/meathook-rs/issues" class="text-ink-dim underline-offset-4 hover:text-accent hover:underline" rel="noopener">Request one</a>.
      Built one?&nbsp;
      <a href="https://github.com/InfiniteUnion/meathook-rs/compare" class="text-ink-dim underline-offset-4 hover:text-accent hover:underline" rel="noopener">Open a PR</a>.
    </p>
  </div>
</section>
